# ============================================
# Campus Crush - 环境变量配置说明
# 复制此文件为 .env 并填入实际值
# ============================================

# MySQL 数据库
MYSQL_URL=jdbc:mysql://localhost:3306/campus_crush?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# QQ邮箱SMTP（发送验证码）
QQ_EMAIL=your_qq_email@qq.com
QQ_EMAIL_AUTH_CODE=your_qq_smtp_auth_code

# 阿里云OSS对象存储
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# JWT
JWT_SECRET=your_jwt_secret_key
