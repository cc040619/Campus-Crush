<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cc.campuscrush.mapper.CommentMapper">
    <resultMap id="CommentResultMap" type="com.cc.campuscrush.entity.Comment">
        <id column="id" property="id" />
        <result column="post_id" property="postId" />
        <result column="user_id" property="userId" />
        <result column="parent_id" property="parentId" />
        <result column="content" property="content" />
        <result column="create_time" property="createTime" />
        <result column="like_count" property="likeCount" />
    </resultMap>

    <select id="selectByPostId" resultMap="CommentResultMap">
        select * from t_comment where post_id = #{postId} order by create_time desc
    </select>

    <select id="selectById" resultMap="CommentResultMap">
        select * from t_comment where id = #{id}
    </select>

    <insert id="insert" parameterType="com.cc.campuscrush.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        insert into t_comment (post_id, user_id, parent_id, content, create_time, like_count)
        values (#{postId}, #{userId}, #{parentId}, #{content}, now(), 0)
    </insert>

    <update id="updateById" parameterType="com.cc.campuscrush.entity.Comment">
        update t_comment
        set content = #{content},
            like_count = #{likeCount}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from t_comment where id = #{id}
    </delete>

    <select id="selectByPostIdWithPage" resultMap="CommentResultMap">
        select * from t_comment where post_id = #{postId} and (parent_id is null or parent_id = 0) order by create_time desc
    </select>

    <delete id="deleteByPostId">
        delete from t_comment where post_id = #{postId}
    </delete>

    <select id="selectByParentId" resultMap="CommentResultMap">
        select * from t_comment where parent_id = #{parentId} order by create_time desc
    </select>

    <delete id="deleteByParentId">
        delete from t_comment where parent_id = #{parentId}
    </delete>

    <select id="selectByPostIdAll" resultMap="CommentResultMap">
        select * from t_comment where post_id = #{postId} order by parent_id asc, create_time asc
    </select>

    <select id="countByPostId" resultType="int">
        select count(*) from t_comment where post_id = #{postId}
    </select>

    <select id="countByUserId" resultType="java.lang.Long">
        select count(*) from t_comment where user_id = #{userId}
    </select>
</mapper>
