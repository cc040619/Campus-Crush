<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cc.campuscrush.mapper.LikeMapper">
    <resultMap id="LikeResultMap" type="com.cc.campuscrush.entity.Like">
        <id column="id" property="id" />
        <result column="post_id" property="postId" />
        <result column="comment_id" property="commentId" />
        <result column="user_id" property="userId" />
        <result column="type" property="type" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <select id="selectByPostIdAndUserId" resultMap="LikeResultMap">
        select * from t_like where post_id = #{postId} and user_id = #{userId} and type = #{type}
    </select>

    <select id="selectByCommentIdAndUserId" resultMap="LikeResultMap">
        select * from t_like where comment_id = #{commentId} and user_id = #{userId} and type = 2
    </select>

    <insert id="insert" parameterType="com.cc.campuscrush.entity.Like">
        insert into t_like (post_id, comment_id, user_id, type, create_time)
        values (#{postId}, #{commentId}, #{userId}, #{type}, now())
    </insert>

    <delete id="deleteById">
        delete from t_like where id = #{id}
    </delete>

    <select id="countByPostIdAndUserId" resultType="int">
        select count(*) from t_like where post_id = #{postId} and user_id = #{userId} and type = #{type}
    </select>

    <delete id="deleteByPostId">
        delete from t_like where post_id = #{postId}
    </delete>

    <delete id="deleteByCommentId">
        delete from t_like where comment_id = #{commentId}
    </delete>

    <select id="countByPostId" resultType="int">
        select count(*) from t_like where post_id = #{postId}
    </select>

    <select id="countByUserId" resultType="java.lang.Long">
        select count(*) from t_like where user_id = #{userId}
    </select>
</mapper>
